{
  "name": "keeproxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keeproxy: one Midnight vault that lets your AI agent, guardians and heirs act for you — privately.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "bash scripts/compactc.sh contract/proxy.compact contract/managed/proxy",
    "compile:fast": "bash scripts/compactc.sh --skip-zk contract/proxy.compact contract/managed/proxy",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --exclude \"src/**/*.sim.test.ts\"",
    "test:sim": "vitest run --passWithNoTests .sim.test.ts",
    "test:local": "cross-env MIDNIGHT_NETWORK=local vitest run --exclude \"src/**/*.sim.test.ts\"",
    "test:preprod": "cross-env MIDNIGHT_NETWORK=preprod vitest run --exclude \"src/**/*.sim.test.ts\"",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "deploy": "vite-node scripts/deploy.ts",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "serve": "vite-node server/keeproxyd.ts",
    "agent:mcp": "vite-node agent/mcp-server.ts",
    "agent": "vite-node agent/demo-agent.ts",
    "setup:compactc": "bash scripts/setup-compactc.sh",
    "receipt": "vite-node scripts/receipt.ts",
    "demo": "vite-node scripts/preprod-demo.ts",
    "dev-wallet": "vite-node scripts/dev-wallet.ts",
    "viewer": "vite-node server/viewer.ts",
    "diagrams": "node docs/diagrams/build.mjs && node scripts/render-diagrams.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "5.0.1",
    "@midnight-ntwrk/testkit-js": "5.0.1",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.0",
    "vite": "6.4.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnightntwrk/zkir-v3": "3.2.1"
  },
  "workspaces": [
    "web"
  ]
}
